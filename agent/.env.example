# LiveKit Configuration (Get from https://cloud.livekit.io or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Model Provider Keys (Choose your preferred providers)
# 1. Deepgram for ultra-low latency Speech-to-Text
DEEPGRAM_API_KEY=your_deepgram_api_key

# 2. OpenAI for LLM and/or TTS
OPENAI_API_KEY=your_openai_api_key

# 3. Cartesia for ultra-realistic low-latency Text-to-Speech (Optional, can use OpenAI TTS)
CARTESIA_API_KEY=your_cartesia_api_key

# 4. Google Gemini (Optional alternative to OpenAI)
GOOGLE_API_KEY=your_google_api_key

# Express Backend URL to stream transcripts & update stats
BACKEND_API_URL=http://localhost:5000/api
BACKEND_SERVICE_TOKEN=your_internal_service_secret
